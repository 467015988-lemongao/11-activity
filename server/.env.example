# 后端服务配置示例：复制为 .env 后填入真实值，.env 不进 Git
PORT=3001
DB_PATH=./data/activity.db

# JWT 密钥（无默认值，缺失时启动报错）；用户端与管理端使用不同密钥
JWT_USER_SECRET=change-me-user-secret
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_EXPIRES_IN=7d

# seed 预置管理员（首次启动写入，已存在则跳过）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123456

# 登录/注册限流：同一 IP 在窗口毫秒内最大请求次数
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
